<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'pl' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Oficjalny sklep domivio — produkty do snu nowej generacji CELL®</title>
  <meta name="description" content="Innowacyjne poduszki ortopedyczne i materace z hipoalergiczną siatką elastomerową TPE CELL®. Darmowa dostawa Paczkomatem InPost i DPD od 99 zł.">
  <meta name="theme-color" content="#7B42F6">
  <meta property="og:type" content="website">
  <meta property="og:title" content="domivio — Poduszki nowej generacji CELL®">
  <meta property="og:description" content="Hipoalergiczna siatka elastomerowa TPE CELL® — zero ucisku, mikroklimat 360° i darmowa dostawa Paczkomatem od 99 zł.">
  <meta property="og:image" content="{{ 'darwin_hero_1.jpg' | asset_url }}">
  <link rel="preload" as="image" href="{{ 'darwin_hero_1.jpg' | asset_url }}" fetchpriority="high">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  {{ 'domivio-styles.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Domivio Sleep Polska",
    "url": "https://domivio-official.com",
    "email": "domivio.official@gmail.com",
    "description": "Innowacyjne poduszki anatomiczne i materace hybrydowe z siatką elastomerową TPE CELL®."
  }
  </script>
</head>
<body>
  {% capture layout_output %}{{ content_for_layout }}{% endcapture %}
  {% if layout_output contains 'domivio-root-marker' %}
    {{ layout_output }}
  {% else %}
    <div style="display:none">{{ layout_output }}</div>
    <div id="domivio-root-marker"></div>
    

  <!-- 1. Top Lavender Announcement Bar (1:1 Darwin) -->
  <div class="dw-topbar">
    <div class="dw-topbar__inner">
      <div class="dw-topbar__city">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71z"/></svg>
        <span data-i18n="top_city">POLSKA</span>
      </div>
      <div class="dw-topbar__promo">
        <span class="dw-topbar__arrow">‹</span>
        <img src="{{ 'darwin_gift_icon.png' | asset_url }}" alt="" class="dw-topbar__gift" />
        <span data-i18n="top_promo">Podaruj zdrowy sen bliskim! Darmowa dostawa Paczkomatem od 99 zł</span>
        <span class="dw-topbar__arrow">›</span>
      </div>
      <a href="mailto:domivio.official@gmail.com" class="dw-topbar__phone">domivio.official@gmail.com</a>
    </div>
  </div>

  <!-- 2. Main White Sticky Header (1:1 Darwin) -->
  <header class="dw-header">
    <div class="dw-header__inner">
      <a href="#" class="dw-logo">domivio</a>

      <nav class="dw-nav">
        <a href="#catalog" class="dw-nav__link" onclick="filterCatalog('poduszki')" data-i18n="nav_pillows">PODUSZKI</a>
        <a href="#catalog" class="dw-nav__link" onclick="filterCatalog('dla-dzieci')" data-i18n="nav_kids">DLA DZIECI</a>
        <a href="#catalog" class="dw-nav__link" onclick="filterCatalog('akcesoria')" data-i18n="nav_accessories">AKCESORIA</a>
        <a href="#catalog" class="dw-nav__link" onclick="filterCatalog('zestawy')" data-i18n="nav_gifts">ZESTAWY</a>
        <a href="#faq" class="dw-nav__link" data-i18n="nav_customers">DLA KLIENTÓW</a>
      </nav>

      <div class="dw-header__icons">
        <div class="dw-lang">
          <button type="button" class="dw-lang__btn is-active" data-lang-btn="pl" onclick="setDomivioLang('pl')">PL</button>
          <button type="button" class="dw-lang__btn" data-lang-btn="en" onclick="setDomivioLang('en')">EN</button>
        </div>
        <button type="button" class="dw-icon-btn dw-bag-btn" onclick="openCartDrawer()" aria-label="Koszyk">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 7h12l1 13H5L6 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
          <span class="dw-bag-badge" id="headerCartCount">0</span>
        </button>
      </div>
    </div>
    <nav class="dw-mobile-nav" aria-label="Kategorie mobilne">
      <a href="#catalog" onclick="filterCatalog('all')">WSZYSTKIE</a>
      <a href="#catalog" onclick="filterCatalog('poduszki')" data-i18n="nav_pillows">PODUSZKI</a>
      <a href="#catalog" onclick="filterCatalog('dla-dzieci')" data-i18n="nav_kids">DLA DZIECI</a>
      <a href="#catalog" onclick="filterCatalog('akcesoria')" data-i18n="nav_accessories">AKCESORIA</a>
      <a href="#catalog" onclick="filterCatalog('zestawy')" data-i18n="nav_gifts">ZESTAWY</a>
      <a href="#faq" data-i18n="contacts_label">KONTAKTY</a>
    </nav>
  </header>

  <!-- 3. Full-Width Hero Banner Slider (1:1 Darwin) -->
  <section class="dw-hero">
    <div class="dw-hero__slide is-active" id="dwHeroSlide1" style="background-image: url('{{ 'darwin_hero_1.jpg' | asset_url }}');">
      <div class="dw-hero__overlay">
        <div class="dw-hero__collab" data-i18n="slide1_collab">DOMIVIO SLEEP TECHNOLOGY</div>
        <div class="dw-hero__bottom">
          <div class="dw-hero__content">
            <h1 class="dw-hero__title" data-i18n="slide1_title">PORANEK BEZ ŚLADÓW WCZORAJSZEGO ZMĘCZENIA ✨</h1>
            <p class="dw-hero__sub" data-i18n="slide1_sub">Siła głębokiego snu i opatentowanej siatki elastomerowej CELL® — podparcie szyi i mikroklimat przez całą noc.</p>
            <a href="#catalog" class="dw-hero__btn" data-i18n="slide1_btn">ZOBACZ KOLEKCJĘ</a>
          </div>
          <div class="dw-hero__pager">
            <button type="button" class="dw-hero__page is-active" onclick="switchDarwinSlide(1)">1</button>
            <button type="button" class="dw-hero__page" onclick="switchDarwinSlide(2)">2</button>
          </div>
        </div>
      </div>
    </div>
    <div class="dw-hero__slide" id="dwHeroSlide2" style="background-image: url('{{ 'darwin_hero_2.jpg' | asset_url }}'); display: none;">
      <div class="dw-hero__overlay">
        <div class="dw-hero__collab" data-i18n="slide2_collab">TESTUJ PRZEZ 14 DNI W DOMU</div>
        <div class="dw-hero__bottom">
          <div class="dw-hero__content">
            <h2 class="dw-hero__title" data-i18n="slide2_title">PODUSZKI NOWEJ GENERACJI CELL®</h2>
            <p class="dw-hero__sub" data-i18n="slide2_sub">Elastyczna kratownica TPE redukuje nacisk, zapobiega zagnieceniom na twarzy i odprowadza ciepło 360°.</p>
            <a href="#catalog" class="dw-hero__btn" data-i18n="slide2_btn">WYBIERZ SWÓJ MODEL</a>
          </div>
          <div class="dw-hero__pager">
            <button type="button" class="dw-hero__page" onclick="switchDarwinSlide(1)">1</button>
            <button type="button" class="dw-hero__page is-active" onclick="switchDarwinSlide(2)">2</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Electric Violet Feature Strip (#7B42F6 — 1:1 Darwin) -->
  <section class="dw-violet-bar">
    <div class="dw-violet-bar__grid">
      <div class="dw-violet-bar__item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
        <span data-i18n="feat_1">OPATENTOWANE TECHNOLOGIE CELL®</span>
      </div>
      <div class="dw-violet-bar__item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/></svg>
        <span data-i18n="feat_2">TERMOREGULACJA I MIKROKLIMAT 360°</span>
      </div>
      <div class="dw-violet-bar__item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        <span data-i18n="feat_3">14 DNI NA TEST I ZWROT</span>
      </div>
      <div class="dw-violet-bar__item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
        <span data-i18n="feat_4">TRWAŁOŚĆ DO 25 LAT BEZ ODKSZTAŁCEŃ</span>
      </div>
      <div class="dw-violet-bar__item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span data-i18n="feat_5">DARMOWY PACZKOMAT OD 99 ZŁ</span>
      </div>
      <div class="dw-violet-bar__item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 20V10M10 20V4M14 20v-8M18 20v-4"/></svg>
        <span data-i18n="feat_6">PŁATNOŚCI BLIK / RATY 0% / KARTA</span>
      </div>
    </div>
  </section>

  <!-- 5. HITY SPRZEDAŻY — 4-Column Product Grid with Prepared Product Slots (1:1 Darwin) -->
  <section class="dw-hits" id="catalog">
    <div class="dw-container">
      <h2 class="dw-section-title" data-i18n="hits_title">HITY SPRZEDAŻY</h2>

      <div class="dw-product-grid" id="productGrid"></div>

      <div class="dw-progress-line">
        <div class="dw-progress-line__fill"></div>
      </div>
    </div>
  </section>

  <!-- 8. Full-Width Welcome to Quality Sleep Banner (1:1 Darwin) -->
  <section class="dw-welcome-banner" style="background-image: url('{{ 'darwin_welcome_sleep.jpg' | asset_url }}');">
    <div class="dw-welcome-banner__overlay">
      <h2 class="dw-welcome-banner__title" data-i18n="welcome_banner_title">WITAJ W ŚWIECIE<br>JAKOŚCIOWEGO SNU</h2>
      <a href="#catalog" class="dw-welcome-banner__btn" data-i18n="welcome_banner_btn">WIĘCEJ O TECHNOLOGII CELL®</a>
    </div>
  </section>

  <!-- 9. Split 50/50 KONTAKTY & MAGAZYN / DOSTAWA Section (1:1 Darwin) -->
  <section class="dw-contacts-split" id="faq">
    <div class="dw-contacts-split__col">
      <div class="dw-contacts-split__label" data-i18n="contacts_label">KONTAKTY</div>
      <a href="tel:+48790532905" class="dw-contacts-split__big">+48 790 532 905</a>
      <a href="mailto:domivio.official@gmail.com" class="dw-contacts-split__big">DOMIVIO.OFFICIAL@GMAIL.COM</a>
      <div class="dw-contacts-split__big">DARMOWA DOSTAWA OD 890 ZŁ</div>

      <div class="dw-social-circles">
        <a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" class="dw-social-circle" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" class="dw-social-circle" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M15.12 5.32H17V2.14A26.11 26.11 0 0 0 14.26 2c-2.72 0-4.58 1.66-4.58 4.7v2.62H6.61v3.56h3.07V22h3.68v-9.12h3.06l.46-3.56h-3.52V6.65c0-1.05.29-1.73 1.76-1.73Z"/></svg>
        </a>
        <a href="https://www.tiktok.com" target="_blank" rel="noopener noreferrer" class="dw-social-circle" aria-label="TikTok">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1Z"/></svg>
        </a>
      </div>
    </div>

    <div class="dw-contacts-split__col">
      <div class="dw-contacts-split__label" data-i18n="showroom_label">MAGAZYN & DOSTAWA W POLSCE</div>
      <div class="dw-contacts-split__big" data-i18n="showroom_title">WYSYŁKA 24H Z POLSKI<br>INPOST PACZKOMATY · DPD PACZKOMATY · KURIER DPD</div>
      <p class="dw-contacts-split__hours" data-i18n="showroom_hours">
        OBSŁUGA KLIENTA: 09:00 DO 20:00, PON–SOB · TEL.: +48 790 532 905<br>
        DARMOWA DOSTAWA OD 890 ZŁ
      </p>

      <button type="button" class="dw-outline-btn" onclick="openCartDrawer()" data-i18n="showroom_btn">
        WYBIERZ PACZKOMAT W KOSZYKU
      </button>
    </div>
  </section>

  <!-- 10. Giant Watermark Logo + Violet CTA (1:1 Darwin) -->
  <section class="dw-watermark-sec">
    <div class="dw-watermark-logo" aria-hidden="true">domivio</div>
    <div class="dw-questions-box">
      <div class="dw-questions-box__label" data-i18n="questions_label">MASZ PYTANIA?</div>
      <a href="mailto:domivio.official@gmail.com" class="dw-questions-box__btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
        <span data-i18n="questions_btn">NAPISZ DO NAS NA E-MAIL</span>
      </a>
    </div>
  </section>

  <!-- Product Detail & Bundle Modal -->
  <div class="pdp-modal" id="pdpModal" role="dialog" aria-modal="true">
    <div class="pdp-modal__backdrop" onclick="closeProductModal()"></div>
    <div class="pdp-modal__dialog">
      <button type="button" class="pdp-modal__close" onclick="closeProductModal()">✕</button>
      <div id="pdpModalContent"></div>
    </div>
  </div>

  <!-- Slide-Out Cart Drawer -->
  <div class="cart-drawer" id="cartDrawer" role="dialog" aria-modal="true">
    <div class="cart-drawer__backdrop" onclick="closeCartDrawer()"></div>
    <div class="cart-drawer__panel">
      <div class="cart-drawer__header">
        <div class="cart-drawer__title" data-i18n="cart_title">TWÓJ KOSZYK</div>
        <button type="button" class="cart-drawer__close" onclick="closeCartDrawer()">✕</button>
      </div>

      <!-- Free Shipping Progress Bar -->
      <div class="ship-bar">
        <div class="ship-bar__label" id="shipBarLabel"></div>
        <div class="ship-bar__track">
          <div class="ship-bar__fill" id="shipBarFill"></div>
        </div>
      </div>

      <div class="cart-drawer__body">
        <div id="cartItemsContainer"></div>
        <div id="cartUpsellsContainer"></div>
      </div>

      <div class="cart-drawer__footer" id="cartDrawerFooter">
        <div class="cart-summary-row">
          <span data-i18n="cart_subtotal">Wartość produktów:</span>
          <span id="cartSubtotalVal">0,00 zł</span>
        </div>
        <div class="cart-summary-row" id="cartShippingRow">
          <span data-i18n="cart_shipping_row">Dostawa:</span>
          <span id="cartShippingVal">0,00 zł</span>
        </div>
        <div class="cart-summary-total">
          <span data-i18n="cart_total">DO ZAPŁATY:</span>
          <span id="cartTotalVal">0,00 zł</span>
        </div>

        <button type="button" class="checkout-btn" onclick="proceedToShopifyCheckout()" data-i18n="cart_checkout_btn">
          PRZEJDŹ DO BEZPIECZNEJ PŁATNOŚCI (BLIK / KARTA) →
        </button>
        <p class="checkout-btn__note" data-i18n="cart_checkout_note">
          Szyfrowana płatność obsługiwana przez Shopify.
        </p>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="toast" id="cartToast">
    <span>✅</span>
    <span id="cartToastMsg">Dodano do koszyka!</span>
  </div>

  <!-- Scripts -->
  
    
<script src="{{ 'domivio-products.js' | asset_url }}"></script>
<script>
  window.DOMIVIO_ASSET_MAP = {
    "darwin_adult_1.png": "{{ 'darwin_adult_1.png' | asset_url }}",
    "darwin_adult_2.png": "{{ 'darwin_adult_2.png' | asset_url }}",
    "darwin_wave_1.png": "{{ 'darwin_wave_1.png' | asset_url }}",
    "darwin_wave_2.png": "{{ 'darwin_wave_2.png' | asset_url }}",
    "darwin_cell_premium.png": "{{ 'darwin_cell_premium.png' | asset_url }}",
    "darwin_evofoam.png": "{{ 'darwin_evofoam.png' | asset_url }}",
    "darwin_dream.png": "{{ 'darwin_dream.png' | asset_url }}",
    "darwin_flat.png": "{{ 'darwin_flat.png' | asset_url }}",
    "darwin_topper.png": "{{ 'darwin_topper.png' | asset_url }}",
    "darwin_pillowcase.png": "{{ 'darwin_pillowcase.png' | asset_url }}"
  };
  (window.DOMIVIO_PRODUCTS || []).forEach(function(p) {
    p.images = (p.images || []).map(function(img) {
      return window.DOMIVIO_ASSET_MAP[img] || img;
    });
  });
</script>
<script src="{{ 'domivio-app.js' | asset_url }}"></script>

  {% endif %}
</body>
</html>
