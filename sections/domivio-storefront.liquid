<script src="{{ 'domivio-products.js' | asset_url }}"></script>
<script>
  window.DOMIVIO_CONFIG.freeShippingPLN = {{ section.settings.free_shipping_pln | default: 99 }};
  window.DOMIVIO_CONFIG.discountCode = {{ section.settings.discount_code | json }};
  window.DOMIVIO_I18N.pl.hero_badge = {{ section.settings.hero_badge | json }};
  window.DOMIVIO_I18N.pl.hero_title = {{ section.settings.hero_title | json }};
  window.DOMIVIO_I18N.pl.hero_subtitle = {{ section.settings.hero_subtitle | json }};
  window.DOMIVIO_I18N.pl.cat_title = {{ section.settings.cat_title | json }};

  // Rewrite local montessori asset paths to Shopify CDN asset_url
  window.DOMIVIO_PRODUCTS.forEach(function(p) {
    if (p.handle === 'drewniana-tablica-sensoryczna-montessori-19-led') {
      p.images = [
        "{{ 'montessori_img_1.jpg' | asset_url }}",
        "{{ 'montessori_studio_1.jpg' | asset_url }}",
        "{{ 'montessori_studio_2.jpg' | asset_url }}",
        "{{ 'montessori_studio_3.jpg' | asset_url }}",
        "{{ 'montessori_img_2.jpg' | asset_url }}"
      ];
    }
  });

  {% if section.settings.domivio_collection != blank %}
    window.DOMIVIO_SHOPIFY_COLLECTION = [
      {% for product in collections[section.settings.domivio_collection].products %}
        {
          id: {{ product.id }},
          variantId: {{ product.selected_or_first_available_variant.id }},
          shopifyVariantId: {{ product.selected_or_first_available_variant.id }},
          handle: {{ product.handle | json }},
          category: ["home", "pets"],
          isMysteryBox: false,
          pricePLN: {{ product.selected_or_first_available_variant.price | divided_by: 100.0 }},
          comparePLN: {{ product.selected_or_first_available_variant.compare_at_price | default: product.selected_or_first_available_variant.price | divided_by: 100.0 }},
          priceEUR: {{ product.selected_or_first_available_variant.price | divided_by: 425.0 | round: 2 }},
          compareEUR: {{ product.selected_or_first_available_variant.compare_at_price | default: product.selected_or_first_available_variant.price | divided_by: 425.0 | round: 2 }},
          rating: "4.9",
          reviewsCount: 185,
          badgePL: "BESTSELLER DOMIVIO 🔥",
          badgeEN: "DOMIVIO BESTSELLER 🔥",
          images: [
            {% for img in product.images limit: 5 %}
              {{ img | image_url: width: 1200 | json }}{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          title: { pl: {{ product.title | json }}, en: {{ product.title | json }} },
          shortDesc: { pl: {{ product.description | strip_html | truncate: 150 | json }}, en: {{ product.description | strip_html | truncate: 150 | json }} },
          bullets: {
            pl: ["🚚 Natychmiastowa wysyłka 24h (InPost Paczkomat & DPD)"],
            en: ["🚚 Fast 24h dispatch (InPost & DPD)"]
          }
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ];
    if (window.DOMIVIO_SHOPIFY_COLLECTION && window.DOMIVIO_SHOPIFY_COLLECTION.length > 0) {
      window.DOMIVIO_PRODUCTS = window.DOMIVIO_SHOPIFY_COLLECTION;
    }
  {% endif %}
</script>
<script src="{{ 'domivio-app.js' | asset_url }}"></script>

