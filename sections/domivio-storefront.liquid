<script src="{{ 'domivio-products.js' | asset_url }}"></script>
<script>
  window.DOMIVIO_ASSET_MAP = {
    "darwin_gift_icon.png": "{{ 'darwin_gift_icon.png' | asset_url }}",
    "darwin_hero_1.jpg": "{{ 'darwin_hero_1.jpg' | asset_url }}",
    "darwin_hero_2.jpg": "{{ 'darwin_hero_2.jpg' | asset_url }}",
    "darwin_cat_mattress.jpg": "{{ 'darwin_cat_mattress.jpg' | asset_url }}",
    "darwin_rev_pill.png": "{{ 'darwin_rev_pill.png' | asset_url }}",
    "darwin_story_1.jpg": "{{ 'darwin_story_1.jpg' | asset_url }}",
    "darwin_story_2.jpg": "{{ 'darwin_story_2.jpg' | asset_url }}",
    "darwin_story_3.jpg": "{{ 'darwin_story_3.jpg' | asset_url }}",
    "darwin_grid_hand.jpg": "{{ 'darwin_grid_hand.jpg' | asset_url }}",
    "darwin_showroom.jpg": "{{ 'darwin_showroom.jpg' | asset_url }}",
    "darwin_welcome_sleep.jpg": "{{ 'darwin_welcome_sleep.jpg' | asset_url }}",
    "darwin_adult_1.png": "{{ 'darwin_adult_1.png' | asset_url }}",
    "darwin_adult_2.png": "{{ 'darwin_adult_2.png' | asset_url }}",
    "darwin_adult_cover.png": "{{ 'darwin_adult_cover.png' | asset_url }}",
    "darwin_adult_grid.png": "{{ 'darwin_adult_grid.png' | asset_url }}",
    "darwin_feat_wash.jpg": "{{ 'darwin_feat_wash.jpg' | asset_url }}",
    "darwin_feat_air.jpg": "{{ 'darwin_feat_air.jpg' | asset_url }}",
    "darwin_feat_forever.jpg": "{{ 'darwin_feat_forever.jpg' | asset_url }}",
    "darwin_wave_1.png": "{{ 'darwin_wave_1.png' | asset_url }}",
    "darwin_wave_2.png": "{{ 'darwin_wave_2.png' | asset_url }}",
    "darwin_cell_premium.png": "{{ 'darwin_cell_premium.png' | asset_url }}",
    "darwin_evofoam.png": "{{ 'darwin_evofoam.png' | asset_url }}",
    "darwin_dream.png": "{{ 'darwin_dream.png' | asset_url }}",
    "darwin_flat.png": "{{ 'darwin_flat.png' | asset_url }}",
    "darwin_topper.png": "{{ 'darwin_topper.png' | asset_url }}",
    "darwin_pillowcase.png": "{{ 'darwin_pillowcase.png' | asset_url }}",
    "domivio_wave_1.jpg": "{{ 'domivio_wave_1.jpg' | asset_url }}",
    "domivio_wave_2.jpg": "{{ 'domivio_wave_2.jpg' | asset_url }}"
  };

  window.DOMIVIO_COLLECTION_MAP = {
    {% for col in collections %}
      "{{ col.handle }}": [{% for p in col.products %}{{ p.id }}{% unless forloop.last %},{% endunless %}{% endfor %}]{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  window.DOMIVIO_METAFIELDS_MAP = {
    {% for col in collections %}
      {% for p in col.products %}
        "{{ p.id }}": {
          "opis": {{ p.metafields.custom.opis.value | default: "" | json }},
          "charakterystyka": {{ p.metafields.custom.charakterystyka.value | default: "" | json }},
          "detale": {{ p.metafields.custom.detale.value | default: "" | json }}
        },
      {% endfor %}
    {% endfor %}
  };

  // Apply Shopify Theme Editor Settings (Customize / Dostosuj)
  (function() {
    var cfg = window.DOMIVIO_CONFIG || {};
    var i18nPL = (window.DOMIVIO_I18N && window.DOMIVIO_I18N.pl) || {};
    var customFreeShip = {{ section.settings.free_shipping_pln | default: 890 | json }};
    if (customFreeShip && Number(customFreeShip) > 0) {
      cfg.freeShippingPLN = Number(customFreeShip);
    }
    var topPromo = {{ section.settings.top_promo | json }};
    if (topPromo) i18nPL.top_promo = topPromo;
    var s1Title = {{ section.settings.slide1_title | json }};
    if (s1Title) i18nPL.slide1_title = s1Title;
    var s1Sub = {{ section.settings.slide1_sub | json }};
    if (s1Sub) i18nPL.slide1_sub = s1Sub;
    var s1Btn = {{ section.settings.slide1_btn | json }};
    if (s1Btn) i18nPL.slide1_btn = s1Btn;
    var s2Title = {{ section.settings.slide2_title | json }};
    if (s2Title) i18nPL.slide2_title = s2Title;
    var s2Sub = {{ section.settings.slide2_sub | json }};
    if (s2Sub) i18nPL.slide2_sub = s2Sub;
    var hitsTitle = {{ section.settings.hits_title | json }};
    if (hitsTitle) i18nPL.hits_title = hitsTitle;
    var revTitle = {{ section.settings.reviews_title | json }};
    if (revTitle) i18nPL.reviews_title = revTitle;
    var revLeftText = {{ section.settings.review_left_text | json }};
    if (revLeftText) i18nPL.review_left_text = revLeftText;

    {% if section.settings.hero_1_image != blank %}
    var s1El = document.getElementById("dwHeroSlide1");
    if (s1El) s1El.style.backgroundImage = "url('{{ section.settings.hero_1_image | image_url: width: 1800 }}')";
    {% endif %}
    {% if section.settings.hero_2_image != blank %}
    var s2El = document.getElementById("dwHeroSlide2");
    if (s2El) s2El.style.backgroundImage = "url('{{ section.settings.hero_2_image | image_url: width: 1800 }}')";
    {% endif %}

    // Load products from Theme Editor blocks if present
    var editorBlocks = [
      {% for block in section.blocks %}
      {% if block.type == "product_card" %}
      {
        id: {{ forloop.index | plus: 1000 }},
        variantId: {{ forloop.index | plus: 1000 }},
        handle: "produkt-" + {{ forloop.index }},
        titlePL: {{ block.settings.title_pl | json }},
        pricePLN: parseFloat({{ block.settings.price_pln | default: "369" | json }}) || 369,
        comparePLN: parseFloat({{ block.settings.compare_pln | default: "459" | json }}) || 459,
        category: {{ block.settings.category | default: "poduszki" | json }},
        specHeight: {{ block.settings.spec_height | default: "8,5/10 cm" | json }},
        specFirm: {{ block.settings.spec_firm | default: "Średnia twardość" | json }},
        sizes: {{ block.settings.sizes | default: "Standard (8,5/10 cm), XL (10/12 cm)" | json }},
        shortDesc: {{ block.settings.short_desc | json }},
        img1: {% if block.settings.image_1 != blank %}"{{ block.settings.image_1 | image_url: width: 1000 }}"{% else %}""{% endif %},
        img2: {% if block.settings.image_2 != blank %}"{{ block.settings.image_2 | image_url: width: 1000 }}"{% else %}""{% endif %},
        img3: {% if block.settings.image_3 != blank %}"{{ block.settings.image_3 | image_url: width: 1000 }}"{% else %}""{% endif %},
        defaultImg1: {{ block.settings.default_img_1 | default: "domivio_wave_1.jpg" | json }}
      },
      {% endif %}
      {% endfor %}
    ];

    if (editorBlocks.length > 0) {
      window.DOMIVIO_PRODUCTS = editorBlocks.map(function(b, idx) {
        var imgs = [];
        if (b.img1) imgs.push(b.img1);
        else if (b.defaultImg1) imgs.push(window.DOMIVIO_ASSET_MAP[b.defaultImg1] || b.defaultImg1);
        if (b.img2) imgs.push(b.img2);
        else if (idx === 0) {
          imgs.push(window.DOMIVIO_ASSET_MAP["domivio_wave_2.jpg"] || "domivio_wave_2.jpg");
          imgs.push(window.DOMIVIO_ASSET_MAP["darwin_adult_cover.png"] || "darwin_adult_cover.png");
          imgs.push(window.DOMIVIO_ASSET_MAP["darwin_adult_grid.png"] || "darwin_adult_grid.png");
        }
        if (b.img3) imgs.push(b.img3);

        var catMap = { "poduszki": "PODUSZKI", "materace": "MATERACE", "dla-dzieci": "DLA DZIECI", "akcesoria": "AKCESORIA" };
        return {
          id: idx === 0 ? 15837514432838 : b.id,
          variantId: idx === 0 ? 57832934801734 : b.variantId,
          shopifyVariantId: idx === 0 ? 57832934801734 : null,
          handle: idx === 0 ? "poduszka-ortopedyczna-adult-cell" : b.handle,
          category: [b.category, "zestawy"],
          catLabelPL: catMap[b.category] || "PODUSZKI",
          catLabelEN: "SLEEP",
          isMysteryBox: idx === 0,
          badges: [{ text: "HIT", type: "hit" }, { text: "SALE", type: "sale" }],
          specTopPL: "≈ " + b.specFirm + "\n↕ " + b.specHeight,
          specTopEN: "≈ " + b.specFirm + "\n↕ " + b.specHeight,
          specHeightPL: "Wysokość — " + b.specHeight,
          specHeightEN: "Height — " + b.specHeight,
          specFirmPL: "Twardość — " + b.specFirm.toLowerCase(),
          specFirmEN: "Firmness — medium",
          pricePLN: b.pricePLN,
          comparePLN: b.comparePLN,
          priceEUR: Math.round(b.pricePLN / 4.25),
          compareEUR: Math.round(b.comparePLN / 4.25),
          rating: "4.9",
          reviewsCount: 149,
          sizes: (b.sizes || "Standard").split(",").map(function(s) { return s.trim(); }).filter(Boolean),
          images: imgs,
          title: { pl: b.titlePL, en: b.titlePL },
          shortDesc: { pl: b.shortDesc, en: b.shortDesc },
          bullets: {
            pl: [
              "💜 Opatentowana kratownica elastomerowa TPE CELL®",
              "❄️ Termoregulacja 360° przez całą noc",
              "🚚 Wysyłka 24h Paczkomatem InPost / DPD (Darmowa dostawa od " + (cfg.freeShippingPLN || 890) + " zł)"
            ],
            en: [
              "💜 Patented TPE CELL® honeycomb grid",
              "❄️ 360° airflow all night",
              "🚚 Free shipping from " + (cfg.freeShippingPLN || 890) + " PLN"
            ]
          }
        };
      });
    } else {
      (window.DOMIVIO_PRODUCTS || []).forEach(function(p) {
        p.images = (p.images || []).map(function(img) {
          return window.DOMIVIO_ASSET_MAP[img] || img;
        });
      });
    }
  })();
</script>
